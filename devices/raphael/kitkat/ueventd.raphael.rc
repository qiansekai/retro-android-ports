# ueventd.raphael.rc — KitKat node ownership for raphael
# Only nodes the MVP touches. KitKat ueventd creates /dev entries from
# kernel uevents; binderfs nodes are created by the kernel at mount time
# and handled in init.raphael.rc, not here.

/dev/dri/card0            0660   system     graphics
/dev/dri/renderD128       0660   system     graphics
/dev/kgsl-3d0             0660   system     graphics
/dev/ion                  0660   system     graphics
/dev/ashmem               0666   root       root
/dev/binder               0666   root       root
/dev/ttyMSM0              0660   system     system
/dev/input/event*         0660   system     input
