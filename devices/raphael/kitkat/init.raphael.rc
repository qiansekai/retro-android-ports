# init.raphael.rc — KitKat bringup for Redmi K20 Pro (SM8150)
# Imported exactly once from init.rc via
#   import /init.${ro.hardware}.rc
# with androidboot.hardware=raphael (set in BOARD_KERNEL_CMDLINE).
# Do NOT add a second import: duplicate parses make init ignore every
# service definition in the second copy.

import /init.raphael.usb.rc

on init
    # Binder on the 4.14 kernel is binderfs (CONFIG_ANDROID_BINDERFS=y),
    # not a misc /dev/binder. KitKat has no binderfs support, so mount it
    # and expose the node where servicemanager expects it. Do this in
    # `on init`, not `early-init`: on KitKat the early action failed
    # silently (no mount in /proc/mounts) and every binder client then
    # crash-looped. binderfs creates the default nodes from
    # CONFIG_ANDROID_BINDER_DEVICES at mount time.
    mkdir /dev/binderfs 0755 root root

    # KitKat policy predates this kernel; enforcing buries the boot in
    # denials. Re-audit later.
    setenforce 0

    # Mountpoints must exist before mounting: a mount onto a missing dir
    # fails ENOENT silently, and a failing init command aborts its whole
    # action. Each mount below is therefore its own `on init` stanza.
    mkdir /system 0755 root root
    mkdir /data 0771 system system
    mkdir /cache 0770 system cache
    mkdir /persist 0771 system system

on init
    # First bringup storage (see fstab.raphael):
    #   system  -> cust partition (sda30, 1 GB, unused by the retrofit
    #              super extents; verified with lpdump 2026-10-17)
    #   cache   -> sda29 (256 MB, shared with the current ROM; only 2 MB
    #              used, KitKat writes nothing important there in MVP)
    #   persist -> sda23
    # Mount syntax: space-separated flags, ONE trailing options arg.
    mount ext4 /dev/block/sda30 /system ro wait

on init
    mount ext4 /dev/block/sda29 /cache nosuid nodev noatime nodiratime wait noauto_da_alloc,barrier=0

on init
    mount ext4 /dev/block/sda23 /persist nosuid nodev wait barrier=1

on init
    # /data is tmpfs: no userdata wipe, no FBE, no vold dependency.
    # 2 GB is enough for dalvik-cache + settings during bringup.
    mount tmpfs tmpfs /data nosuid nodev noatime size=2G

on init
    # KitKat's Debug/Environment reads EXTERNAL_STORAGE at zygote
    # preload time; without it getLegacyExternalStorageDirectory()
    # returns null and zygote dies with an NPE. No real sdcard is
    # required, the paths only have to exist.
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /storage/emulated 0555 root root
    mkdir /storage/emulated/legacy 0770 shell shell
    export EXTERNAL_STORAGE /storage/emulated/legacy
    export EMULATED_STORAGE_SOURCE /mnt/shell/emulated
    export EMULATED_STORAGE_TARGET /storage/emulated
    symlink /storage/emulated/legacy /sdcard
    symlink /storage/emulated/legacy /mnt/sdcard
    symlink /storage/emulated/legacy /storage/sdcard0

on init
    # /system and /cache are mounted now; the helper scripts live on
    # /system and write to /cache.
    start bindermount
    start bootstage
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    mkdir /data/misc/log 0775 system log
    mkdir /data/local 0771 shell shell
    mkdir /data/local/tmp 0771 shell shell
    mkdir /data/dalvik-cache 0771 system system
    mkdir /data/property 0700 root root
    mkdir /data/system 0775 system system
    mkdir /data/anr 0775 system system

    chmod 0755 /system/bin/dump-boot-log.sh
    chmod 0755 /sbin/autowinch.sh
    chmod 0755 /sbin/usbudc.sh
    chmod 0755 /sbin/glrenderd.sh
    chmod 0755 /sbin/bindermount.sh
    chmod 0755 /sbin/bootstage.sh
    chmod 0755 /sbin/zygote-wrap.sh

on post-fs-data
    # glrenderd must be up before SurfaceFlinger's first EGL/gralloc
    # probe (the decision is cached per process). On raphael there is no
    # fb0 yet; this service will exit until the display fork lands.
    start glrenderd

on boot
    start adbd
    start usbudc
    start bootlog

# Diagnostic logger: KitKat logcat is blind on this kernel (no
# CONFIG_ANDROID_LOGGER), so snapshot dmesg/ps into files for pull.
service bootlog /system/bin/dump-boot-log.sh
    user root
    disabled

# Early diagnostic: dump mounts/dev/props/dmesg to /cache so a failed
# boot still leaves evidence for the next adb session.
service bootstage /system/bin/sh /sbin/bootstage.sh
    class core
    user root
    oneshot

# Mount binderfs when the kernel has it; with CONFIG_ANDROID_BINDERFS=n
# the misc /dev/binder from ueventd is kept untouched.
service bindermount /system/bin/sh /sbin/bindermount.sh
    class core
    user root
    oneshot

# Adreno renderer (guest GL over @glrenderd). Disabled by default: on
# raphael it needs the display fork (vfb/DRM) before it can present.
service glrenderd /system/bin/sh /sbin/glrenderd.sh
    class core
    disabled
